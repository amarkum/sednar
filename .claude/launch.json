      },
      "port": 9001
    },
    {
      "name": "sednar-public",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "server.py"
      ],
      "env": {
        "SEDNAR_PORT": "9002",
        "SEDNAR_PUBLIC_ROOT": ".public-visitors",
        "SEDNAR_SECRET_KEY": "local-public-test"
